{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "parallax.DetectionSet",
  "type": "object",
  "properties": {
    "query": {
      "type": "string"
    },
    "query_revision": {
      "type": "integer",
      "minimum": 1
    },
    "detected": {
      "type": "boolean"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "sequence"
      ],
      "additionalProperties": false
    },
    "detections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "integer"
          },
          "score": {
            "type": "number"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "width": {
            "type": "number"
          },
          "height": {
            "type": "number"
          }
        },
        "required": [
          "label",
          "score",
          "x",
          "y",
          "width",
          "height"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "query",
    "query_revision",
    "detected",
    "count",
    "source",
    "detections"
  ],
  "additionalProperties": false
}